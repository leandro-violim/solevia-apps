# Release signing credentials for Zen Bubbles (Android).
#
# 1. Copy this file to `keystore.properties` in the SAME folder (android/).
#    That real file is gitignored — it must NEVER be committed.
# 2. Generate your upload keystore and fill in the values below.
#    Full walkthrough: ../store-assets/play/SIGNING.md
#
# storeFile can be an absolute path, or a path relative to android/app/.
# Keeping the .jks OUTSIDE the repo (e.g. ~/keys/) is safest.

storeFile=/Users/leandroviolim/keys/zenbubbles-upload.jks
storePassword=CHANGE_ME
keyAlias=zenbubbles-upload
keyPassword=CHANGE_ME
