# Cap Kickers — Android release signing (Play upload key).
#
# Copy this file to `android/keystore.properties` (which is gitignored — NEVER
# commit it or the .jks) and fill in the real values. Then reference it from
# android/app/build.gradle in a signingConfigs { release { ... } } block.
#
# Create the keystore once and back it up somewhere durable — if you lose it you
# can never update the Play listing:
#   keytool -genkey -v -keystore ~/keys/capkickers-upload.jks \
#     -alias capkickers -keyalg RSA -keysize 2048 -validity 10000

# Absolute path to the .jks, or a path relative to android/app/
storeFile=/absolute/path/to/capkickers-upload.jks
storePassword=CHANGE_ME
keyAlias=capkickers
keyPassword=CHANGE_ME
